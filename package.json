{
  "name": "alpinejs-component",
  "version": "3.0.0",
  "description": "Directive-based Alpine.js components with slots and cached template rendering",
  "keywords": [
    "alpinejs",
    "alpinejs-component",
    "template-rendering",
    "html-components",
    "slots"
  ],
  "author": "Mark Mead",
  "license": "MIT",
  "homepage": "https://github.com/markmead/alpinejs-component#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmead/alpinejs-component.git"
  },
  "bugs": {
    "url": "https://github.com/markmead/alpinejs-component/issues"
  },
  "type": "module",
  "main": "dist/component.esm.js",
  "module": "dist/component.esm.js",
  "unpkg": "dist/component.min.js",
  "exports": {
    ".": {
      "import": "./dist/component.esm.js",
      "default": "./dist/component.esm.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "builds/"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:css": "tailwindcss --input tests/fixtures/app.css --output tests/fixtures/tailwind.css",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "prebuild": "pnpm run lint",
    "test": "pnpm run build && playwright test",
    "test:serve": "pnpm run build:css && serve . --config tests/serve.json --listen 3210 --listen 3211 --cors --no-clipboard --no-request-logging",
    "test:ui": "pnpm run build && playwright test --ui"
  },
  "devDependencies": {
    "@alpinejs/csp": "^3.15.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.15.12",
    "esbuild": "^0.27.7",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3"
  }
}
